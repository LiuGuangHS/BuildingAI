{
    "name": "echoflow-video",
    "version": "0.0.1",
    "description": "面向创作者的 AI 视频生成工作台，支持文生视频、图生视频、视频编辑、任务历史和算力计费。",
    "author": "EchoflowAI Teams",
    "private": true,
    "main": "./manifest.json",
    "module": "./manifest.json",
    "files": [
        "build/**/*"
    ],
    "exports": {
        ".": {
            "import": "./manifest.json",
            "require": "./manifest.json"
        },
        "./api": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js",
            "require": "./build/index.js"
        },
        "./*": "./*"
    },
    "scripts": {
        "build:clean": "rimraf build .nuxt .output .temp",
        "dev:web": "vite",
        "dev:api": "cross-env NODE_ENV=development tsup --watch src/api",
        "dev": "concurrently -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
        "build:api": "cross-env NODE_ENV=production tsup",
        "build:web": "vite build",
        "build:publish": "rimraf build .nuxt .output .temp && vite build && cross-env NODE_ENV=production tsup",
        "format": "prettier --write src",
        "lint": "eslint src --quiet",
        "lint:fix": "eslint src --fix",
        "check-types": "vue-tsc --noEmit",
        "test": "vue-tsc --noEmit && node ../../packages/api/node_modules/jest/bin/jest.js --runInBand --passWithNoTests",
        "test:unit": "node ../../packages/api/node_modules/jest/bin/jest.js --runInBand --passWithNoTests",
        "test:watch": "vue-tsc --noEmit --watch",
        "i18n:translate": "node ../../scripts/translate-i18n.mjs"
    },
    "dependencies": {
        "@buildingai/base": "workspace:*",
        "@buildingai/cache": "workspace:*",
        "@buildingai/constants": "workspace:*",
        "@buildingai/core": "workspace:*",
        "@buildingai/db": "workspace:*",
        "@buildingai/decorators": "workspace:*",
        "@buildingai/dto": "workspace:*",
        "@buildingai/errors": "workspace:*",
        "@buildingai/extension-sdk": "workspace:*",
        "@buildingai/hooks": "workspace:*",
        "@buildingai/http": "workspace:*",
        "@buildingai/i18n": "workspace:*",
        "@buildingai/pipe": "workspace:*",
        "@buildingai/services": "workspace:*",
        "@buildingai/stores": "workspace:*",
        "@buildingai/ui": "workspace:*",
        "@buildingai/web-core": "workspace:*",
        "@nestjs/bullmq": "catalog:api",
        "@nestjs/common": "catalog:api",
        "@tanstack/react-query": "^5.90.21",
        "bullmq": "catalog:api",
        "class-transformer": "catalog:api",
        "class-validator": "catalog:api",
        "lucide-react": "catalog:web",
        "react": "catalog:web",
        "react-dom": "catalog:web",
        "react-router-dom": "catalog:web",
        "sonner": "^2.0.7"
    },
    "devDependencies": {
        "@playwright/test": "catalog:dev",
        "@tailwindcss/vite": "catalog:web",
        "@buildingai/eslint-config": "workspace:*",
        "@buildingai/typescript-config": "workspace:*",
        "@buildingai/web-types": "workspace:*",
        "@types/react": "catalog:web",
        "@types/react-dom": "catalog:web",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "catalog:dev",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "tsup": "^8.5.1"
    },
    "engine": {
        "buildingai": ">=25.1.0"
    },
    "jest": {
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": ".",
        "testRegex": "tests/api/.*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "<rootDir>/../../packages/api/node_modules/ts-jest",
                {
                    "tsconfig": "tsconfig.spec.json"
                }
            ]
        },
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@buildingai/base$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/cache$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/core/decorators$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/db/@nestjs/typeorm$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/db/entities$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/db/typeorm$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/errors$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/utils$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/constants/(.*)$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/extension-sdk$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/core/modules$": "<rootDir>/tests/api/test-utils/buildingai-stubs.ts",
            "^@buildingai/core$": "<rootDir>/../../packages/core/src",
            "^@buildingai/core/(.*)$": "<rootDir>/../../packages/core/src/$1",
            "^@buildingai/db$": "<rootDir>/../../packages/@buildingai/db/src",
            "^@buildingai/db/(.*)$": "<rootDir>/../../packages/@buildingai/db/src/$1",
            "^@buildingai/(.*)$": "<rootDir>/../../packages/@buildingai/$1/src"
        }
    }
}
