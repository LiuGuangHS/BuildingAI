{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoFlowAI",
  "version": "26.0.0",
  "identifier": "com.echoflow.aiclient",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4091",
    "frontendDist": "https://ai.echoflow.cn/"
  },
  "app": {
    "windows": [
      {
        "title": "EchoFlowAI",
        "width": 1152,
        "height": 720,
        "minWidth": 1152,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
